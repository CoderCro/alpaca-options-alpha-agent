# Alpaca paper trading account dedicated to this hackathon (fresh account, $100,000 balance)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# No base-URL variable needed -- alpaca-py's TradingClient takes paper=True
# and resolves the correct host/version itself.

# Featherless AI (serverless inference for open-source models)
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=

# Hugging Face Inference API token (Company C only -- FinBERT sentiment
# context for the Featherless veto call). Optional: sentiment.get_sentiment
# fails closed to None without it, same as a missing/bad quote -- Company C
# still trades, just without the extra context. Get a token with
# "Inference Providers" permission at https://huggingface.co/settings/tokens
HUGGINGFACE_API_TOKEN=
